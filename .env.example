# DrillDown Unified Application — Environment Template
# Copy into the app root:  cp .env.example .env
# Not all variables are required for every mode.

# =============================================================================
# SHARED
# =============================================================================
API_HOST=127.0.0.1
API_PORT=8000

# =============================================================================
# ECOMMERCE MODE
# =============================================================================
GOOGLE_API_KEY=

QDRANT_PATH=./data/qdrant_storage
COLLECTION_NAME=fashion_products
UPLOADS_DIR=./data/ecommerce/uploads
DEBUG_DIR=./data/ecommerce/debug
DATASET_IMAGES_DIR=./data/fashion-dataset/images
REDIS_URL=redis://localhost:6379

# =============================================================================
# EXPLAINER — VISION
# =============================================================================
HF_TOKEN=
SAM2_PATH=
DEFAULT_GROUNDING_MODE=
EXPLAINER_STATIC_DIR=./data/explainer/static
OLLAMA_BASE=http://localhost:11434
EXPLAINER_VISION_MODEL=qwen3.5:9b

# =============================================================================
# EXPLAINER — IMAGE GENERATION
# =============================================================================
IMAGE_MODEL=x/flux2-klein:4b-bf16
VISION_MODEL=qwen2.5vl:7b
MODEL_PROVIDER=ollama

# LLM routing: ollama (direct) | litellm (LiteLLM SDK for chat/VLM)
LLM_PROVIDER=ollama
LITELLM_PROXY_BASE=http://localhost:4000
LITELLM_API_KEY=
AGENT_ORCHESTRATOR_MODEL=llama3.1

# =============================================================================
# SPECULATIVE DRILL — MULTI-MAC WORKER POOL
# =============================================================================
# Image backend: ollama (local) | mock | remote (single Flux server) |
# pool (distribute hotspots across several worker Macs).
IMAGE_BACKEND=pool

# VLM + parent/overview image + free-click CHILD images run on THIS (main) Mac:
VLM_OLLAMA_BASE=http://localhost:11434
MAIN_IMAGE_BASE=http://localhost:11434

# Comma-separated worker endpoints — HOTSPOTS are generated here, in parallel.
# Use LAN IPs (http://192.168.x.x:11434) or ngrok URLs (https://xxx.ngrok-free.dev).
# Leave empty to fall back to OLLAMA_BASE (single machine).
IMAGE_OLLAMA_BASES=

# Concurrent image jobs per worker Mac (Flux is heavy; tune to each Mac's RAM).
IMAGE_WORKER_CONCURRENCY=1
IMAGE_GEN_TIMEOUT=300
IMAGE_GEN_MAX_RETRIES=2

# Overlap child gen (main) with hotspot gen (workers) for low latency.
SPEC_OVERLAP=true

# Bind worker connections to this main-Mac LAN IP to bypass a corporate VPN tunnel
# (only for the LAN/route approach; leave EMPTY when using ngrok).
BIND_LAN_IP=

# Single dedicated Flux worker server (only for IMAGE_BACKEND=remote; unused for pool).
REMOTE_FLUX_BASE=http://localhost:9000

# Completed speculative-drill sessions flush here (SQLite, gitignored).
DRILL_SESSIONS_DB=./data/explainer/drill_sessions.db

# =============================================================================
# FRONTEND (Vite)
# =============================================================================
VITE_API_BASE=http://127.0.0.1:8000
VITE_DEFAULT_MODE=explainer
