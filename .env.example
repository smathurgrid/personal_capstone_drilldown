# DrillDown Unified Application — Environment Template
# Copy into the app root:  cp .env.example .env
# Not all variables are required for every mode.

# =============================================================================
# SHARED
# =============================================================================
API_HOST=127.0.0.1
API_PORT=8001
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CORS_ORIGIN_REGEX=https?://(127\.0\.0\.1|localhost):\d+

# =============================================================================
# AUTH / DATABASE / CACHE
# =============================================================================
# Local development default. Use postgresql://... in production or if you run Postgres locally.
DATABASE_URL=sqlite+aiosqlite:///./data/drilldown.db
AUTH_SECRET_KEY=replace-with-a-long-random-production-secret
AUTH_COOKIE_NAME=drilldown_session
AUTH_COOKIE_SECURE=false
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=1440
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=86400

# =============================================================================
# ECOMMERCE MODE
# =============================================================================
GOOGLE_API_KEY=

QDRANT_PATH=./data/qdrant_storage
COLLECTION_NAME=fashion_products
UPLOADS_DIR=./data/ecommerce/uploads
DEBUG_DIR=./data/ecommerce/debug
DATASET_IMAGES_DIR=./data/fashion-dataset/images

# =============================================================================
# EXPLAINER — VISION
# =============================================================================
HF_TOKEN=
SAM2_PATH=
DEFAULT_GROUNDING_MODE=
EXPLAINER_STATIC_DIR=./data/explainer/static
OLLAMA_BASE=http://localhost:11434
EXPLAINER_VISION_MODEL=qwen3.5:9b

# =============================================================================
# EXPLAINER — IMAGE GENERATION
# =============================================================================
IMAGE_MODEL=x/flux2-klein:4b
VISION_MODEL=qwen2.5vl:7b
MODEL_PROVIDER=ollama

# LLM routing: ollama (direct) | litellm (LiteLLM SDK for chat/VLM)
LLM_PROVIDER=ollama
LITELLM_PROXY_BASE=http://localhost:4000
LITELLM_API_KEY=
AGENT_ORCHESTRATOR_MODEL=llama3.1

# =============================================================================
# FRONTEND (Vite)
# =============================================================================
VITE_API_BASE=
VITE_DEFAULT_MODE=explainer
